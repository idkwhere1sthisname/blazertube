    "storeContent": [
        {
            "info": {
                "title": "BlazerTube",
                "author": "idkwh, nebulagamez",
                "description": "Native YouTube 3DS app revival",
                "category": ["revival"],
                "console": ["3DS"],
                "icon_index": 2,
                "sheet_index": 0,
                "last_updated": "2026-08-07 at 14:09 (UTC)",
                "license": "MIT",
                "releasenotes": "This update skips over the launcher and instead downloads an IPS compared to a whole binary.",
                "version": "v2.5",
                "screenshots": [
                    {
                        "description": "3DS paired with a TV",
                        "url": "http://unistore.3ds.idkwh.ct8.pl/my/store/lp1/youtube/images/1.png"
                    },
                    {
                        "description": "Popular page",
                        "url": "http://unistore.3ds.idkwh.ct8.pl/my/store/lp1/youtube/images/2.png"
                    },
                    {
                        "description": "Sidebar",
                        "url": "http://unistore.3ds.idkwh.ct8.pl/my/store/lp1/youtube/images/3.png"
                    },
                    {
                        "description":"YouTube channel",
                        "url":"http://unistore.3ds.idkwh.ct8.pl/my/store/lp1/youtube/images/4.png"
                    },
                    {
                        "description":"Playing a video (bottom)",
                        "url":"http://unistore.3ds.idkwh.ct8.pl/my/store/lp1/youtube/images/5-b.png"
                    },
                    {
                        "description":"Playing a video (top)",
                        "url":"http://unistore.3ds.idkwh.ct8.pl/my/store/lp1/youtube/images/5-t.png"
                    }
                ]
            },
            "Install... (EUR)": [
                {
                    "type":"promptMessage",
                    "message": "Be sure to enable game patching in Luma3DS (hold SELECT while booting your console, then enable \"Enable Game Patching\")."
                },
                {
                    "type":"promptMessage",
                    "message": "You will need Pretendo Network installed and enabled to use this (via Nimbus)."
                },
                {
                    "type":"promptMessage",
                    "message": "You will need a copy of YouTube v2080 installed."
                },
                {
                    "type":"promptMessage",
                    "message":"The service is in public beta, it may not work as expected."
                },
                {
                    "type":"mkdir",
                    "directory":"sdmc:/luma/titles/00040000000CCD00/"
                },
                {
                    "type":"downloadFile",
                    "file":"http://unistore.3ds.idkwh.ct8.pl/my/store/lp1/youtube/eu/code.ips",
                    "output":"sdmc:/luma/titles/00040000000CCD00/code.ips"
                }
            ],
